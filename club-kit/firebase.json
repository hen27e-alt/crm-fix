{
  "functions": [
    {
      "source": "functions",
      "codebase": "club",
      "runtime": "nodejs20",
      "predeploy": ["node scripts/sync-config.js"],
      "ignore": ["node_modules", ".git", "test", "*.log"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": { "port": 8080 },
    "functions": { "port": 5001 },
    "ui": { "enabled": true }
  }
}
