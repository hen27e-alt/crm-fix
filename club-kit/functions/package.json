{
  "name": "club-kit-functions",
  "version": "1.0.0",
  "private": true,
  "description": "Club Kit backend: checkout, payment webhook, account deletion, user bootstrap (Firebase Functions v2, region europe-west1)",
  "main": "index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-club-kit \"node --test test/rules/*.test.js\"",
    "sync-config": "node ../scripts/sync-config.js",
    "serve": "firebase emulators:start --only functions,firestore",
    "deploy": "firebase deploy --only functions,firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "firebase-admin": "13.10.0",
    "firebase-functions": "6.6.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0"
  }
}
